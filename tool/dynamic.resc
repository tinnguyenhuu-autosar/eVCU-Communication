:name: Dynamic eVCU Test Network
emulation CreateCANHub "canHub"

mach create "eVCU"
machine LoadPlatformDescription @E:/AUTOSAR_Tai_Lieu/Student_ECU/debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend @E:/AUTOSAR_Tai_Lieu/Student_ECU/tool/logs/evcu_uart.log true
sysbus LoadELF @E:/AUTOSAR_Tai_Lieu/Student_ECU/tool/evcu.elf
machine StartGdbServer 3333

mach create "Diag_ECU"
machine LoadPlatformDescription @E:/AUTOSAR_Tai_Lieu/Student_ECU/debug/stm32f103_full.repl
connector Connect sysbus.can1 canHub
sysbus.usart1 CreateFileBackend @E:/AUTOSAR_Tai_Lieu/Student_ECU/tool/logs/diag_uart.log true
sysbus LoadELF @E:/AUTOSAR_Tai_Lieu/Student_ECU/Diag_ECU/diag_ecu.elf
machine StartGdbServer 3334

logLevel 3 sysbus
# start
